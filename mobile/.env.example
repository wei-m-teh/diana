# Environment variables for the Diana Flutter app.
# Copy this file to `.env` and fill in the values.

# LiveKit Cloud Sandbox token server ID.
# Create one at: https://cloud.livekit.io  ->  Settings -> Sandbox -> Token Server
# The mobile app uses this to fetch a connection token at runtime
# (see lib/controllers/app_ctrl.dart).
LIVEKIT_SANDBOX_ID=
