# Deployment metadata only. Store credential VALUES in AWS Secrets Manager.
AWS_REGION=us-east-1
# Complete ARN (including its generated suffix) of an existing JSON secret.
LIVEKIT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:diana/livekit-AbCdEf
# Optional; defaults are one on-demand task, 2 vCPU, 4 GiB RAM.
AGENT_DESIRED_COUNT=1
AGENT_CPU=2048
AGENT_MEMORY_MIB=4096

# Optional Google sign-in: supply BOTH values to enable it for web and mobile.
# The existing Secrets Manager JSON secret must contain a client_secret field.
# Never put the Google client secret itself in this file.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:diana/google-oauth-AbCdEf

# Optional direct OpenRouter LLM access (agent only).
# Set both to enable; the secret is JSON with an OPENROUTER_API_KEY field.
# Create the dedicated secret under diana/ and tag application=conversation-agent.
# OPENROUTER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:diana/openrouter-AbCdEf
# OPENROUTER_MODEL=provider/model-id
# OPENROUTER_VISION_MODEL=provider/image-capable-model-id

# Use OpenRouter for Deepgram speech; requires the OpenRouter key/secret above.
DIANA_SPEECH_PROVIDER=livekit
