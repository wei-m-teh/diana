LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional direct LLM provider. Leave livekit until credentials are ready.
DIANA_LLM_PROVIDER=livekit
OPENROUTER_API_KEY=
# Explicit OpenRouter model ID; no automatic model selection.
OPENROUTER_MODEL=
# Optional image-capable model; defaults to OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=

# Use OpenRouter for Deepgram speech; requires the OpenRouter key/secret above.
DIANA_SPEECH_PROVIDER=livekit

# Optional output-only override; blank preserves existing speech/voice routing.
# Values: livekit, openrouter, elevenlabs. STT still uses DIANA_SPEECH_PROVIDER.
DIANA_TTS_PROVIDER=
# Direct ElevenLabs credentials stay on the agent, never in web/mobile env files.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v4
# Optional deployment-wide OpenRouter TTS override. Set both or neither.
# Without an override, existing Deepgram voice selection is retained.
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=

# Web media generation through the existing OpenRouter key (paid, on request).
DIANA_IMAGE_MODEL=google/gemini-2.5-flash-image
DIANA_VIDEO_MODEL=x-ai/grok-imagine-video
