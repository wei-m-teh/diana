LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional direct LLM provider. Leave livekit until credentials are ready.
DIANA_LLM_PROVIDER=livekit
OPENROUTER_API_KEY=
# Explicit OpenRouter model ID; no automatic model selection.
OPENROUTER_MODEL=
# Optional image-capable model; defaults to OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=

# Use OpenRouter for Deepgram speech; requires the OpenRouter key/secret above.
DIANA_SPEECH_PROVIDER=livekit
